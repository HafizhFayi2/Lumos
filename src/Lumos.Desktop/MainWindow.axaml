<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lumos.Desktop.ViewModels"
        xmlns:controls="using:Lumos.Desktop.Controls"
        x:Class="Lumos.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lumos"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="600"
        Background="#0D1117"
        WindowStartupLocation="CenterScreen">

  <Window.Styles>

    <!-- ── Tab RadioButton ────────────────────────────────────────────── -->
    <Style Selector="RadioButton.tab">
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,20,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Padding="0,8,0,0" Background="Transparent">
            <StackPanel Spacing="0">
              <ContentPresenter Name="PART_Content"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Margin="0,0,0,6"/>
              <Border Name="PART_Bar" Height="2" CornerRadius="1" Background="Transparent"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.tab:checked">
      <Setter Property="Foreground" Value="#F4F8FC"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#PART_Bar">
      <Setter Property="Background" Value="#2986F6"/>
    </Style>
    <Style Selector="RadioButton.tab:pointerover">
      <Setter Property="Foreground" Value="#C9D1D9"/>
    </Style>

    <!-- ── Toolbar icon button ─────────────────────────────────────────── -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C2430"/>
      <Setter Property="TextElement.Foreground" Value="#C9D1D9"/>
    </Style>
    <Style Selector="Button.icon:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#232C38"/>
    </Style>

    <!-- ── Menu button ────────────────────────────────────────────────── -->
    <Style Selector="Button.menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.menu:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#111820"/>
    </Style>

    <!-- ── Primary button ─────────────────────────────────────────────── -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#2986F6"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Padding" Value="16,7"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E6FD1"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#1860BA"/>
    </Style>

    <!-- ── Secondary button ───────────────────────────────────────────── -->
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="#11161D"/>
      <Setter Property="BorderBrush" Value="#232C38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C2430"/>
      <Setter Property="TextElement.Foreground" Value="#C9D1D9"/>
    </Style>

    <!-- ── Transport button ───────────────────────────────────────────── -->
    <Style Selector="Button.transport">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.transport:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C2430"/>
    </Style>

    <!-- ── Quick-action chip button ──────────────────────────────────── -->
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="#11161D"/>
      <Setter Property="BorderBrush" Value="#232C38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#8B949E"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1C2430"/>
      <Setter Property="TextElement.Foreground" Value="#C9D1D9"/>
    </Style>

    <!-- ── TextBox search ─────────────────────────────────────────────── -->
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="#11161D"/>
      <Setter Property="BorderBrush" Value="#232C38"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="#C9D1D9"/>
      <Setter Property="CaretBrush" Value="#2986F6"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#2986F6"/>
    </Style>

    <!-- ── Track label ────────────────────────────────────────────────── -->
    <Style Selector="TextBlock.track-type">
      <Setter Property="FontSize" Value="9"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#3D4A5C"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>

  </Window.Styles>

  <Grid RowDefinitions="44,*">

    <!-- ══ TOP BAR ══════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Background="#0D1117" BorderBrush="#1A212B" BorderThickness="0,0,0,1"
            ZIndex="10">
      <Grid ColumnDefinitions="Auto,*,Auto">

        <!-- Logo + Menu items -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="28" Height="28" Margin="10,0,6,0" CornerRadius="6" Background="#2986F6">
            <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Button Classes="menu" Name="MenuFile"    Content="File"/>
          <Button Classes="menu" Name="MenuEdit"    Content="Edit"/>
          <Button Classes="menu" Name="MenuTimeline" Content="Timeline"/>
          <Button Classes="menu" Name="MenuView"    Content="View"/>
          <Button Classes="menu" Name="MenuWindow"  Content="Window"/>
          <Button Classes="menu" Name="MenuHelp"    Content="Help"/>
        </StackPanel>

        <!-- Center: project name + auto-saved -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Spacing="8">
          <TextBlock Name="ProjectNameText" Text="{Binding ProjectName}"
                     Foreground="#D7E3F0" FontSize="13" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <Ellipse Width="6" Height="6" Fill="#4ADE80"/>
            <TextBlock Text="Auto-saved" Foreground="#5C6A7C" FontSize="11"/>
          </StackPanel>
        </StackPanel>

        <!-- Right: Undo / Redo / Settings / Export -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                    Spacing="2" Margin="0,0,12,0">
          <Button Classes="icon" Name="BtnUndo" ToolTip.Tip="Undo" FontSize="16">↩</Button>
          <Button Classes="icon" Name="BtnRedo" ToolTip.Tip="Redo" FontSize="16">↪</Button>
          <Border Width="1" Height="18" Background="#232C38" Margin="4,0"/>
          <Button Classes="icon" Name="BtnSettings" ToolTip.Tip="Settings" FontSize="15">⚙</Button>
          <Button Classes="primary" Name="BtnExport" Margin="8,0,0,0">Export</Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- ══ MAIN AREA ══════════════════════════════════════════════════════ -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*,320">

      <!-- ── LEFT PANEL: Media Library ───────────────────────────────── -->
      <Grid Grid.Column="0" RowDefinitions="38,Auto,*" Background="#161C26">

        <!-- Panel tab bar -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="#1A212B" BorderThickness="0,0,0,1"
                Padding="14,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
            <RadioButton Classes="tab" GroupName="MediaPanelTab" Content="Media" IsChecked="{Binding IsMediaTabActive, Mode=OneWay}" Name="TabMedia"/>
            <RadioButton Classes="tab" GroupName="MediaPanelTab" Content="Effects" IsChecked="{Binding IsEffectsTabActive, Mode=OneWay}" Name="TabEffects"/>
            <RadioButton Classes="tab" GroupName="MediaPanelTab" Content="Library" IsChecked="{Binding IsLibraryTabActive, Mode=OneWay}" Name="TabLibrary"/>
          </StackPanel>
        </Border>

        <!-- Search + Import -->
        <StackPanel Grid.Row="1" Margin="10,8" Spacing="6">
          <TextBox Classes="search" Name="SearchBox" Watermark="Search media..." Text="" />
          <Button Classes="secondary" Name="BtnImport" HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center" Height="30" IsVisible="{Binding IsMediaTabActive}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="⬇" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Text="Import" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>

        <!-- Content Area -->
        <Grid Grid.Row="2">
          
          <!-- Tab 1: Media -->
          <ScrollViewer IsVisible="{Binding IsMediaTabActive}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <!-- Project Assets header -->
              <Border Padding="12,6" Background="#111820" Margin="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="▸" Foreground="#5C6A7C" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="Project Assets" Foreground="#8B949E"
                             FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- Empty media state -->
              <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Spacing="10" IsVisible="{Binding !HasAssets}">
                <Border Width="52" Height="52" CornerRadius="26" Background="#1C2430"
                        HorizontalAlignment="Center">
                  <TextBlock Text="🎬" FontSize="22"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No media imported" Foreground="#5C6A7C" FontSize="12"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Click Import to add files" Foreground="#2A3440" FontSize="11"
                           HorizontalAlignment="Center"/>
              </StackPanel>

              <!-- Asset List -->
              <ItemsControl ItemsSource="{Binding Assets}" IsVisible="{Binding HasAssets}" Margin="8">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Stretch" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="120" Height="105" Margin="4" CornerRadius="6" Background="#1C2430" BorderBrush="#232C38" BorderThickness="1" Padding="4" DoubleTapped="OnAssetDoubleTapped" Cursor="Hand">
                      <ToolTip.Tip>Double-click to add to Playhead</ToolTip.Tip>
                      <Grid RowDefinitions="65,Auto,Auto">
                        <!-- Thumbnail -->
                        <Border Grid.Row="0" CornerRadius="4" Background="#0D1117" ClipToBounds="True">
                          <Grid>
                            <TextBlock Text="{Binding Symbol}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border Background="#A0000000" CornerRadius="3" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="3" Padding="3,1">
                              <TextBlock Text="{Binding Duration}" Foreground="#F4F8FC" FontSize="8" FontFamily="Consolas,Menlo,monospace"/>
                            </Border>
                          </Grid>
                        </Border>
                        <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="#D7E3F0" FontSize="10" TextTrimming="CharacterEllipsis" Margin="2,4,2,0"/>
                        <TextBlock Grid.Row="2" Text="{Binding Type}" Foreground="#5C6A7C" FontSize="8" Margin="2,1,2,0"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Tab 2: Effects -->
          <ScrollViewer IsVisible="{Binding IsEffectsTabActive}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Spacing="8">
              <TextBlock Text="Video Effects" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold"/>
              <Border Height="40" Background="#1C2430" CornerRadius="4" BorderBrush="#232C38" BorderThickness="1" Padding="10,0" DoubleTapped="OnEffectDoubleTapped" Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="🎨  Auto Color Grade" Foreground="#D7E3F0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="+" Foreground="#2986F6" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Height="40" Background="#1C2430" CornerRadius="4" BorderBrush="#232C38" BorderThickness="1" Padding="10,0" DoubleTapped="OnEffectDoubleTapped" Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="🔳  Chroma Key (Green Screen)" Foreground="#D7E3F0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="+" Foreground="#2986F6" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Height="40" Background="#1C2430" CornerRadius="4" BorderBrush="#232C38" BorderThickness="1" Padding="10,0" DoubleTapped="OnEffectDoubleTapped" Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="🔇  Noise Reduction" Foreground="#D7E3F0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="+" Foreground="#2986F6" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- Tab 3: Library -->
          <ScrollViewer IsVisible="{Binding IsLibraryTabActive}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Spacing="8">
              <TextBlock Text="Presets &amp; Overlays" Foreground="#8B949E" FontSize="12" FontWeight="SemiBold"/>
              <Border Height="40" Background="#1C2430" CornerRadius="4" BorderBrush="#232C38" BorderThickness="1" Padding="10,0" DoubleTapped="OnLibraryDoubleTapped" Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="🎵  Ambient Music Loop" Foreground="#D7E3F0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="+" Foreground="#2986F6" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <Border Height="40" Background="#1C2430" CornerRadius="4" BorderBrush="#232C38" BorderThickness="1" Padding="10,0" DoubleTapped="OnLibraryDoubleTapped" Cursor="Hand">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="📝  Subtitle Overlay Template" Foreground="#D7E3F0" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="+" Foreground="#2986F6" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </StackPanel>
          </ScrollViewer>

        </Grid>
      </Grid>

      <!-- ── CENTER: Preview + Timeline ─────────────────────────────── -->
      <Grid Grid.Column="1" RowDefinitions="*,42,36,*" Background="#0A0E13">

        <!-- Preview monitor -->
        <Border Grid.Row="0" Background="#000000" ClipToBounds="True">
          <Grid>
            <!-- When no clips are loaded, show this empty placeholder -->
            <StackPanel Name="PreviewPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsVisible="{Binding !HasClips}">
              <Border Width="60" Height="60" CornerRadius="30" Background="#111820"
                      HorizontalAlignment="Center">
                <TextBlock Text="▶" FontSize="26" Foreground="#2986F6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="3,0,0,0"/>
              </Border>
              <TextBlock Text="No timeline loaded" Foreground="#3D4A5C" FontSize="12"
                         HorizontalAlignment="Center"/>
            </StackPanel>
            
            <!-- Video frame rendering -->
            <Image Name="PreviewImage" Stretch="Uniform" IsVisible="{Binding HasClips}"/>
          </Grid>
        </Border>

        <!-- Transport bar -->
        <Border Grid.Row="1" Background="#0D1117" BorderBrush="#1A212B"
                BorderThickness="0,1,0,1">
          <Grid ColumnDefinitions="160,*,160" Margin="12,0">
            <TextBlock Grid.Column="0" Name="TimecodeText" Text="{Binding TimeCode}"
                       Foreground="#8B949E" FontFamily="Consolas,Menlo,monospace"
                       FontSize="13" FontWeight="Medium" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Classes="transport" Name="BtnToStart"    ToolTip.Tip="Go to start">⏮</Button>
              <Button Classes="transport" Name="BtnStepBack"   ToolTip.Tip="Step back">⏪</Button>
              <Border Width="34" Height="34" CornerRadius="17" Background="#1C2430">
                <Button Classes="transport" Name="BtnPlayPause" ToolTip.Tip="Play / Pause"
                        Background="Transparent" BorderBrush="Transparent"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Content="{Binding PlayPauseIcon}"></Button>
              </Border>
              <Button Classes="transport" Name="BtnStepFwd"  ToolTip.Tip="Step forward">⏩</Button>
              <Button Classes="transport" Name="BtnToEnd"    ToolTip.Tip="Go to end">⏭</Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock Text="1920×1080" Foreground="#5C6A7C" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Text="30 fps" Foreground="#5C6A7C" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Timeline toolbar -->
        <Border Grid.Row="2" Background="#0D1117" BorderBrush="#1A212B"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2" Margin="8,0" VerticalAlignment="Center">
              <Button Classes="icon" Name="ToolPointer"  ToolTip.Tip="Pointer (V)" Foreground="#2986F6">↖</Button>
              <Button Classes="icon" Name="ToolRazor"    ToolTip.Tip="Razor (C)">✂</Button>
              <Button Classes="icon" Name="ToolSlip"     ToolTip.Tip="Slip trim">⇔</Button>
              <Button Classes="icon" Name="ToolLink"     ToolTip.Tip="Link clips">🔗</Button>
              <Button Classes="icon" Name="ToolMagnet"   ToolTip.Tip="Toggle snapping" Foreground="#2986F6">⊡</Button>
              <Border Width="1" Height="16" Background="#232C38" Margin="4,0"/>
              <TextBlock Text="Actions:" Foreground="#5C6A7C" FontSize="11" VerticalAlignment="Center" Margin="4,0"/>
              <Button Classes="secondary" Name="BtnSplitAction" Content="Split" Padding="6,2" Height="22" FontSize="11" Margin="2,0"/>
              <Button Classes="secondary" Name="BtnDeleteAction" Content="Delete" Padding="6,2" Height="22" FontSize="11" Margin="2,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,12,0">
              <TextBlock Text="Zoom" Foreground="#5C6A7C" FontSize="11" VerticalAlignment="Center"/>
              <Slider Name="ZoomSlider" Width="100" Minimum="1.0" Maximum="15.0" Value="{Binding ZoomScale, Mode=TwoWay}"
                      VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- Timeline tracks area -->
        <Grid Grid.Row="3" ColumnDefinitions="90,*">

          <!-- Track headers column (static on left) -->
          <Border Grid.Column="0" Background="#0D1117" BorderBrush="#1A212B"
                  BorderThickness="0,0,1,0" ZIndex="2">
            <StackPanel Margin="0,20,0,0">
              <!-- V2 header -->
              <Border Height="56" BorderBrush="#1A212B" BorderThickness="0,0,0,1"
                      Padding="8,0" Background="#161C26">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="V2" Foreground="#C9D1D9" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Classes="track-type" Text="VIDEO"/>
                </StackPanel>
              </Border>
              <!-- V1 header -->
              <Border Height="56" BorderBrush="#1A212B" BorderThickness="0,0,0,1"
                      Padding="8,0" Background="#1C2430">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="V1" Foreground="#C9D1D9" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Classes="track-type" Text="VIDEO"/>
                </StackPanel>
              </Border>
              <!-- A1 header -->
              <Border Height="56" BorderBrush="#1A212B" BorderThickness="0,0,0,1"
                      Padding="8,0" Background="#1C2430">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="A1" Foreground="#C9D1D9" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Classes="track-type" Text="AUDIO"/>
                </StackPanel>
              </Border>
              <!-- A2 header -->
              <Border Height="56" BorderBrush="#1A212B" BorderThickness="0,0,0,1"
                      Padding="8,0" Background="#161C26">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="A2" Foreground="#C9D1D9" FontSize="12" FontWeight="SemiBold"/>
                  <TextBlock Classes="track-type" Text="AUDIO"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Scrollable Track Content Area -->
          <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Hidden" Name="TimelineScrollViewer">
            <Grid Width="{Binding TimelineWidthPixels}" Background="#0A0E13">
              <Grid RowDefinitions="20,*">

                <!-- Ruler strip — dynamic ticks via TimelineRulerControl -->
                <Border Grid.Row="0" Height="20" Background="#0A0E13" BorderBrush="#1A212B" BorderThickness="0,0,0,1" Name="TimelineRulerBorder" Cursor="SizeWestEast">
                  <controls:TimelineRulerControl Name="RulerControl" Height="20"
                    ZoomScale="{Binding ZoomScale}"
                    Fps="{Binding Fps}"
                    HorizontalAlignment="Stretch"/>
                </Border>

                <!-- Track Rows stacked -->
                <Grid Grid.Row="1" Height="224" Name="TimelineTracksContainer">
                  
                  <!-- Background grid rows -->
                  <StackPanel>
                    <!-- V2 Track background -->
                    <Border Height="56" Background="#090D12" BorderBrush="#1A212B" BorderThickness="0,0,0,1" Name="TrackLaneV2"/>
                    <!-- V1 Track background -->
                    <Border Height="56" Background="#090D12" BorderBrush="#1A212B" BorderThickness="0,0,0,1" Name="TrackLaneV1"/>
                    <!-- A1 Track background -->
                    <Border Height="56" Background="#090D12" BorderBrush="#1A212B" BorderThickness="0,0,0,1" Name="TrackLaneA1"/>
                    <!-- A2 Track background -->
                    <Border Height="56" Background="#090D12" BorderBrush="#1A212B" BorderThickness="0,0,0,1" Name="TrackLaneA2"/>
                  </StackPanel>

                  <!-- V2 Clips ItemsControl -->
                  <Canvas Height="56" VerticalAlignment="Top" Margin="0,0,0,0" Background="Transparent" IsHitTestVisible="True">
                    <ItemsControl ItemsSource="{Binding V2Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas Height="56"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="48" Margin="0,4" CornerRadius="6" Background="{Binding ColorHex}" BorderBrush="{Binding BorderHex}" BorderThickness="2" Canvas.Left="{Binding Left}" Width="{Binding Width}" Cursor="Hand" PointerPressed="OnClipPointerPressed">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Symbol}" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="#F4F8FC" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Border Grid.Column="1" Background="#30FFFFFF" CornerRadius="4" Margin="0,0,6,0" Padding="4,2" IsVisible="{Binding IsAI}">
                                <TextBlock Text="AI" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold"/>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>

                  <!-- V1 Clips ItemsControl -->
                  <Canvas Height="56" VerticalAlignment="Top" Margin="0,56,0,0" Background="Transparent" IsHitTestVisible="True">
                    <ItemsControl ItemsSource="{Binding V1Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas Height="56"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="48" Margin="0,4" CornerRadius="6" Background="{Binding ColorHex}" BorderBrush="{Binding BorderHex}" BorderThickness="2" Canvas.Left="{Binding Left}" Width="{Binding Width}" Cursor="Hand" PointerPressed="OnClipPointerPressed">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Symbol}" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="#F4F8FC" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Border Grid.Column="1" Background="#30FFFFFF" CornerRadius="4" Margin="0,0,6,0" Padding="4,2" IsVisible="{Binding IsAI}">
                                <TextBlock Text="AI" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold"/>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>

                  <!-- A1 Clips ItemsControl -->
                  <Canvas Height="56" VerticalAlignment="Top" Margin="0,112,0,0" Background="Transparent" IsHitTestVisible="True">
                    <ItemsControl ItemsSource="{Binding A1Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas Height="56"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="48" Margin="0,4" CornerRadius="6" Background="{Binding ColorHex}" BorderBrush="{Binding BorderHex}" BorderThickness="2" Canvas.Left="{Binding Left}" Width="{Binding Width}" Cursor="Hand" PointerPressed="OnClipPointerPressed">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Symbol}" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="#F4F8FC" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Border Grid.Column="1" Background="#30FFFFFF" CornerRadius="4" Margin="0,0,6,0" Padding="4,2" IsVisible="{Binding IsAI}">
                                <TextBlock Text="AI" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold"/>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>

                  <!-- A2 Clips ItemsControl -->
                  <Canvas Height="56" VerticalAlignment="Top" Margin="0,168,0,0" Background="Transparent" IsHitTestVisible="True">
                    <ItemsControl ItemsSource="{Binding A2Clips}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas Height="56"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Height="48" Margin="0,4" CornerRadius="6" Background="{Binding ColorHex}" BorderBrush="{Binding BorderHex}" BorderThickness="2" Canvas.Left="{Binding Left}" Width="{Binding Width}" Cursor="Hand" PointerPressed="OnClipPointerPressed">
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{Binding Symbol}" FontSize="12" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding Name}" Foreground="#F4F8FC" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Border Grid.Column="1" Background="#30FFFFFF" CornerRadius="4" Margin="0,0,6,0" Padding="4,2" IsVisible="{Binding IsAI}">
                                <TextBlock Text="AI" Foreground="#FFFFFF" FontSize="8" FontWeight="Bold"/>
                              </Border>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>

                  <!-- Playhead layer (spans whole container, doesn't intercept clicks) -->
                  <Canvas Background="Transparent" IsHitTestVisible="False" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <!-- vertical line -->
                    <Rectangle Fill="#4FC3F7" Width="2" Height="224" Canvas.Left="{Binding PlayheadLeft}"/>
                    <!-- handle triangle -->
                    <Polygon Points="0,0 12,0 6,10" Fill="#4FC3F7" Canvas.Left="{Binding PlayheadHandleLeft}"/>
                  </Canvas>

                </Grid>

              </Grid>
            </Grid>
          </ScrollViewer>

        </Grid>

      </Grid>

      <!-- ── RIGHT PANEL: AI Assistant ──────────────────────────────── -->
      <Grid Grid.Column="2" RowDefinitions="38,*,Auto" Background="#161C26">

        <!-- Tab bar -->
        <Border Grid.Row="0" Background="#0D1117" BorderBrush="#1A212B"
                BorderThickness="0,0,0,1" Padding="14,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
            <RadioButton Classes="tab" GroupName="AITab" Content="Assistant" IsChecked="{Binding IsAssistantTabActive, Mode=OneWay}" Name="TabAssistant"/>
            <RadioButton Classes="tab" GroupName="AITab" Content="MCP Activity" IsChecked="{Binding IsMcpTabActive, Mode=OneWay}" Name="TabMcp"/>
          </StackPanel>
        </Border>

        <!-- Chat / empty state (Assistant Tab) -->
        <Grid Grid.Row="1" IsVisible="{Binding IsAssistantTabActive}">
          <Grid RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0" Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <!-- Messages -->
                <ItemsControl ItemsSource="{Binding AIChatMessages}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="8" Margin="8,4" Padding="10,8" MaxWidth="250"
                              HorizontalAlignment="{Binding Alignment}"
                              Background="{Binding BackgroundHex}">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Text}" Foreground="{Binding ForegroundHex}" FontSize="12" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding Time}" Foreground="#5C6A7C" FontSize="9" HorizontalAlignment="Right"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- AI typing indicator -->
                <Border CornerRadius="8" Background="#1C2430" Padding="10,8" Margin="8,4" HorizontalAlignment="Left" IsVisible="{Binding AITyping}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6" Height="6" Fill="#4FC3F7"/>
                    <TextBlock Text="Lumos AI is editing..." Foreground="#5C6A7C" FontSize="11" FontStyle="Italic"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>

            <!-- Quick Action Chips -->
            <StackPanel Grid.Row="1" Spacing="6" Margin="10,8">
              <Button Classes="chip" Name="ChipSilences">✂  Remove silences</Button>
              <Button Classes="chip" Name="ChipColorGrade">🎨  Auto color grade</Button>
              <Button Classes="chip" Name="ChipCaptions">📝  Generate captions</Button>
              <!-- MCP connected indicator -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6" Margin="0,4,0,0">
                <Ellipse Width="6" Height="6" Fill="#4ADE80" VerticalAlignment="Center"/>
                <TextBlock Text="MCP Connected" Foreground="#5C6A7C" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- MCP Logs (MCP Activity Tab) -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsMcpTabActive}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding McpActivityLogs}" Margin="12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" Foreground="#4ADE80" FontFamily="Consolas,Menlo,monospace" FontSize="11" Margin="0,2" TextWrapping="Wrap"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Input area -->
        <Border Grid.Row="2" Background="#0D1117" BorderBrush="#1A212B"
                BorderThickness="0,1,0,0" Padding="10,8">
          <Grid ColumnDefinitions="*,Auto">
            <Border Grid.Column="0" Background="#11161D" CornerRadius="8"
                    BorderBrush="#232C38" BorderThickness="1">
              <TextBox Name="AIChatInput"
                       Background="Transparent" BorderBrush="Transparent"
                       Padding="10,7"
                       Watermark="Ask AI to edit, analyze, or generate..."
                       Foreground="#C9D1D9" CaretBrush="#2986F6"
                       FontSize="12"
                       AcceptsReturn="False"
                       TextWrapping="Wrap"/>
            </Border>
            <Button Grid.Column="1" Classes="primary" Name="BtnSendAI"
                    Width="34" Height="34" Padding="0" CornerRadius="17"
                    Margin="6,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
              <TextBlock Text="↑" FontSize="16" FontWeight="Bold"/>
            </Button>
          </Grid>
        </Border>

      </Grid>

    </Grid>
  </Grid>
</Window>
