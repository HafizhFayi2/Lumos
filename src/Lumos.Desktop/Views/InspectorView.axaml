<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Lumos.Desktop.ViewModels"
             x:Class="Lumos.Desktop.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">
  <Border Background="#09090b" BorderBrush="#3f3f46" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" Padding="12">
        <TextBlock Text="Inspector" Foreground="#f8fafc" FontWeight="SemiBold"/>
      </Border>
      <ScrollViewer Grid.Row="1">
        <StackPanel Margin="12" Spacing="16">
          <TextBlock Text="{Binding ClipName}" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
          
          <ItemsControl ItemsSource="{Binding Effects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#121214" CornerRadius="6" BorderBrush="#27272a" BorderThickness="1" Margin="0,0,0,8">
                  <StackPanel>
                    <!-- Header -->
                    <Border Background="#18181b" CornerRadius="6,6,0,0" Padding="12,8">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#e2e8f0" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="✕" Foreground="#ef4444" FontSize="10" Padding="4" Background="Transparent"
                                Command="{Binding $parent[UserControl].((vm:InspectorViewModel)DataContext).RemoveEffectCommand}" 
                                CommandParameter="{Binding Id}"/>
                      </Grid>
                    </Border>
                    <!-- Parameters (mock UI for now) -->
                    <StackPanel Margin="12" Spacing="8">
                      <TextBlock Text="Intensity" Foreground="#94a3b8" FontSize="10"/>
                      <Slider Minimum="0" Maximum="1" Value="0.5"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
