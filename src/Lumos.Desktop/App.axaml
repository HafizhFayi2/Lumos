<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Lumos.Desktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Lumos Design System: mirrors LumosTheme.cs constants for XAML -->
        <ResourceInclude Source="/Themes/LumosTheme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
