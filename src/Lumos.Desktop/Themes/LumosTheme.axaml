<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=netstandard">

  <!-- ============================================================
       Lumos Design System — Resource Dictionary
       Mirrors LumosTheme.cs constants for XAML resource binding.
       Code-behind should continue to use LumosTheme.cs directly.
       ============================================================ -->

  <!-- ── Colors ───────────────────────────────────────────────── -->

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="BgApp">#09090b</SolidColorBrush>
  <SolidColorBrush x:Key="BgPanel">#18181b</SolidColorBrush>
  <SolidColorBrush x:Key="BgElevated">#121214</SolidColorBrush>
  <SolidColorBrush x:Key="BgHover">#27272a</SolidColorBrush>
  <SolidColorBrush x:Key="BgInput">#1e1e24</SolidColorBrush>
  <SolidColorBrush x:Key="BgOverlay">#CC000000</SolidColorBrush>
  <SolidColorBrush x:Key="BgBlack">#000000</SolidColorBrush>
  <SolidColorBrush x:Key="BgTabActive">#09090b</SolidColorBrush>

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimary">#f8fafc</SolidColorBrush>
  <SolidColorBrush x:Key="TextSecondary">#94a3b8</SolidColorBrush>
  <SolidColorBrush x:Key="TextTertiary">#64748b</SolidColorBrush>
  <SolidColorBrush x:Key="TextMuted">#475569</SolidColorBrush>
  <SolidColorBrush x:Key="TextAccent">#3b82f6</SolidColorBrush>
  <SolidColorBrush x:Key="TextGood">#10b981</SolidColorBrush>

  <!-- Borders -->
  <SolidColorBrush x:Key="BorderDefault">#3f3f46</SolidColorBrush>
  <SolidColorBrush x:Key="BorderSubtle">#27272a</SolidColorBrush>
  <SolidColorBrush x:Key="BorderAccent">#3b82f6</SolidColorBrush>

  <!-- Accent -->
  <SolidColorBrush x:Key="AccentBlue">#3b82f6</SolidColorBrush>
  <SolidColorBrush x:Key="AccentBlueBg">#1e3a8a22</SolidColorBrush>
  <SolidColorBrush x:Key="AccentBlueHover">#60a5fa</SolidColorBrush>
  <SolidColorBrush x:Key="AccentBluePressed">#2563eb</SolidColorBrush>

  <!-- Semantic -->
  <SolidColorBrush x:Key="Danger">#F87171</SolidColorBrush>
  <SolidColorBrush x:Key="Warning">#F59E0B</SolidColorBrush>
  <SolidColorBrush x:Key="Success">#10b981</SolidColorBrush>
  <SolidColorBrush x:Key="Purple">#8B5CF6</SolidColorBrush>
  <SolidColorBrush x:Key="PurpleBg">#291651</SolidColorBrush>

  <!-- Track -->
  <SolidColorBrush x:Key="TrackVideoBg">#1A2744</SolidColorBrush>
  <SolidColorBrush x:Key="TrackAudioBg">#11291A</SolidColorBrush>
  <SolidColorBrush x:Key="TrackTextBg">#24133A</SolidColorBrush>
  <SolidColorBrush x:Key="TrackImageBg">#2A2015</SolidColorBrush>
  <SolidColorBrush x:Key="TrackVideoBorder">#1E5CA8</SolidColorBrush>
  <SolidColorBrush x:Key="TrackAudioBorder">#2E8B57</SolidColorBrush>
  <SolidColorBrush x:Key="TrackSelectedVideoBg">#1E3B5E</SolidColorBrush>
  <SolidColorBrush x:Key="TrackSelectedAudioBg">#1C452C</SolidColorBrush>
  <SolidColorBrush x:Key="TrackSelectedTextBg">#3C1F5E</SolidColorBrush>
  <SolidColorBrush x:Key="TrackSelectedImageBg">#3D3020</SolidColorBrush>
  <SolidColorBrush x:Key="TrackSelectedVideoBorder">#2986F6</SolidColorBrush>
  <SolidColorBrush x:Key="TrackSelectedAudioBorder">#4ADE80</SolidColorBrush>

  <!-- Playhead -->
  <SolidColorBrush x:Key="PlayheadLine">#4FC3F7</SolidColorBrush>
  <SolidColorBrush x:Key="PlayheadHandle">#4FC3F7</SolidColorBrush>
  <SolidColorBrush x:Key="PlayheadGlow">#304FC3F7</SolidColorBrush>
  <SolidColorBrush x:Key="PlayheadLabelBg">#E8161C26</SolidColorBrush>
  <SolidColorBrush x:Key="PlayheadLabelText">#E1F5FE</SolidColorBrush>
  <SolidColorBrush x:Key="SnapLine">#2986F6</SolidColorBrush>
  <SolidColorBrush x:Key="SnapLabelBg">#E8161C26</SolidColorBrush>
  <SolidColorBrush x:Key="SnapLabelText">#81D4FA</SolidColorBrush>

  <!-- Effects -->
  <SolidColorBrush x:Key="ClipEffectBorder">#60A5FA</SolidColorBrush>
  <SolidColorBrush x:Key="ClipEffectFill">#40FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="ClipWaveform">#804ADE80</SolidColorBrush>
  <SolidColorBrush x:Key="AiBadgeBg">#291651</SolidColorBrush>
  <SolidColorBrush x:Key="AiBadgeFg">#A855F7</SolidColorBrush>

  <!-- Chat -->
  <SolidColorBrush x:Key="ChatUserBg">#1E3B5E</SolidColorBrush>
  <SolidColorBrush x:Key="ChatUserText">#F4F8FC</SolidColorBrush>
  <SolidColorBrush x:Key="ChatAiBg">#1C2430</SolidColorBrush>
  <SolidColorBrush x:Key="ChatAiText">#D7E3F0</SolidColorBrush>
  <SolidColorBrush x:Key="ChatTyping">#1e1e24</SolidColorBrush>

  <!-- ── Spacing (Thickness helper) ─────────────────────────────── -->

  <sys:Double x:Key="SpacingXxs">2</sys:Double>
  <sys:Double x:Key="SpacingXs">4</sys:Double>
  <sys:Double x:Key="SpacingSm">8</sys:Double>
  <sys:Double x:Key="SpacingMd">12</sys:Double>
  <sys:Double x:Key="SpacingLg">16</sys:Double>
  <sys:Double x:Key="SpacingXl">24</sys:Double>
  <sys:Double x:Key="SpacingXxl">32</sys:Double>
  <sys:Double x:Key="SpacingXxxl">48</sys:Double>

  <!-- Common Thickness shortcuts -->
  <Thickness x:Key="PaddingXxs">2</Thickness>
  <Thickness x:Key="PaddingXs">4</Thickness>
  <Thickness x:Key="PaddingSm">8</Thickness>
  <Thickness x:Key="PaddingMd">12</Thickness>
  <Thickness x:Key="PaddingLg">16</Thickness>
  <Thickness x:Key="PaddingXl">24</Thickness>
  <Thickness x:Key="PaddingXxl">32</Thickness>
  <Thickness x:Key="PaddingXxxl">48</Thickness>

  <!-- ── Font sizes ─────────────────────────────────────────────── -->

  <sys:Double x:Key="FontSizeXxs">9</sys:Double>
  <sys:Double x:Key="FontSizeXs">10</sys:Double>
  <sys:Double x:Key="FontSizeSm">11</sys:Double>
  <sys:Double x:Key="FontSizeMd">12</sys:Double>
  <sys:Double x:Key="FontSizeLg">13</sys:Double>
  <sys:Double x:Key="FontSizeXl">14</sys:Double>
  <sys:Double x:Key="FontSizeXxl">15</sys:Double>
  <sys:Double x:Key="FontSizeXxxl">16</sys:Double>
  <sys:Double x:Key="FontSizeDisplay">18</sys:Double>
  <sys:Double x:Key="FontSizeTimecode">16</sys:Double>

  <!-- ── Corner radii ───────────────────────────────────────────── -->

  <CornerRadius x:Key="RadiusXs">2</CornerRadius>
  <CornerRadius x:Key="RadiusSm">4</CornerRadius>
  <CornerRadius x:Key="RadiusMd">6</CornerRadius>
  <CornerRadius x:Key="RadiusLg">8</CornerRadius>
  <CornerRadius x:Key="RadiusXl">12</CornerRadius>
  <CornerRadius x:Key="RadiusXxl">16</CornerRadius>
  <CornerRadius x:Key="RadiusXxxl">20</CornerRadius>
  <CornerRadius x:Key="RadiusRound">28</CornerRadius>
  <CornerRadius x:Key="RadiusFull">9999</CornerRadius>

  <!-- ── Border widths ──────────────────────────────────────────── -->

  <sys:Double x:Key="BorderHairline">0.5</sys:Double>
  <sys:Double x:Key="BorderThin">1.0</sys:Double>
  <sys:Double x:Key="BorderMedium">1.5</sys:Double>
  <sys:Double x:Key="BorderThick">2.0</sys:Double>

  <!-- ── Opacity ────────────────────────────────────────────────── -->

  <sys:Double x:Key="OpacitySubtle">0.1</sys:Double>
  <sys:Double x:Key="OpacityFaint">0.3</sys:Double>
  <sys:Double x:Key="OpacityMuted">0.6</sys:Double>
  <sys:Double x:Key="OpacityMedium">0.7</sys:Double>
  <sys:Double x:Key="OpacityStrong">0.85</sys:Double>
  <sys:Double x:Key="OpacitySolid">1.0</sys:Double>

  <!-- ── Icon sizes ─────────────────────────────────────────────── -->

  <sys:Double x:Key="IconSizeXs">14</sys:Double>
  <sys:Double x:Key="IconSizeSm">15</sys:Double>
  <sys:Double x:Key="IconSizeMd">18</sys:Double>
  <sys:Double x:Key="IconSizeLg">20</sys:Double>
  <sys:Double x:Key="IconSizeXl">24</sys:Double>
  <sys:Double x:Key="IconSizeXxl">56</sys:Double>

  <!-- ── Track dimensions ───────────────────────────────────────── -->

  <sys:Double x:Key="TrackHeight">56</sys:Double>
  <sys:Double x:Key="TrackRulerHeight">28</sys:Double>
  <sys:Double x:Key="TrackHeaderWidth">120</sys:Double>
  <sys:Double x:Key="TrackMinHeight">32</sys:Double>
  <sys:Double x:Key="TrackMaxHeight">200</sys:Double>
  <sys:Double x:Key="TrackTrimHandleWidth">6</sys:Double>
  <sys:Double x:Key="TrackFadeDrawWidth">24</sys:Double>

  <!-- ── Window defaults ────────────────────────────────────────── -->

  <sys:Double x:Key="WindowDefaultWidth">1280</sys:Double>
  <sys:Double x:Key="WindowDefaultHeight">720</sys:Double>
  <sys:Double x:Key="WindowMinWidth">1200</sys:Double>
  <sys:Double x:Key="WindowMinHeight">680</sys:Double>

</ResourceDictionary>
