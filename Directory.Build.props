<Project>
  <PropertyGroup>
    <!-- Enable deterministic NuGet restore – generates a packages.lock.json that
         pins every transitive dependency version. This ensures CI and local builds
         use identical package versions, preventing "works on my machine" bugs. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Re-run restore when lock file changes to detect drift -->
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>
</Project>
